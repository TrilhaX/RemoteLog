    criar("UIListLayout", {
        Padding = UDim.new(0, 5),
        SortOrder = Enum.SortOrder.LayoutOrder,
    }, s)
    return s
end

local function copiar(b, texto)
    if setclipboard then
        setclipboard(texto)
    end
    local original = b.Text
    if original == "Copied!" then
        return
    end
    b.Text = "Copied!"
    task.delay(0.8, function()
        if b.Parent then
            b.Text = original
        end
    end)
end

-- Formatação
local function caminho(inst)
    local partes = {}
    local atual = inst
    while atual and atual.Parent ~= game do
        table.insert(partes, 1, (":WaitForChild(%q)"):format(atual.Name))
        atual = atual.Parent
    end
    if not atual then
        return "-- outside game: " .. inst.Name
    end
    return ("game:GetService(%q)"):format(atual.ClassName) .. table.concat(partes)
end

local function numero(n)
    if n ~= n then return "0/0" end
    if n == math.huge then return "math.huge" end
    if n == -math.huge then return "-math.huge" end
    return tostring(n)
end

local function chaveTabela(k, formatar, nivel)
    if type(k) == "string" and k:match("^[%a_][%w_]*$") then
        return k
    end
    return "[" .. formatar(k, nivel + 1) .. "]"
end

-- Tabelas em formatação agora (detecta ciclo) e orçamento de itens da tabela mais externa.
local tabelaTexto
do
    local emAndamento = {}
    local profundidade, orcamento = 0, 0

    tabelaTexto = function(v, nivel, formatar, limite)
        if next(v) == nil then
            return "{}"
        end
        if emAndamento[v] then
            return "{} --[[ cycle ]]"
        end
        if nivel >= limite then
            return "{...}"
        end
        if profundidade == 0 then
            orcamento = 3000
        end

        local recuo = string.rep("    ", nivel + 1)
        local partes, indice, qtd = {}, 1, 0
        emAndamento[v] = true
        profundidade += 1
        local ok, err = pcall(function()
            for k, val in next, v do
                qtd += 1
                orcamento -= 1
                if qtd > 150 or orcamento < 0 then
                    table.insert(partes, recuo .. "-- more items omitted")
                    break
                end
                if k == indice then
                    indice += 1
                    table.insert(partes, recuo .. formatar(val, nivel + 1))
                else
                    table.insert(partes, recuo .. chaveTabela(k, formatar, nivel) .. " = " .. formatar(val, nivel + 1))
                end
            end
        end)
        profundidade -= 1
        emAndamento[v] = nil
        if not ok then
            error(err, 0)
        end
        return "{\n" .. table.concat(partes, ",\n") .. "\n" .. string.rep("    ", nivel) .. "}"
    end
end

local function mostrar(v, nivel)
    nivel = nivel or 0
    local t = typeof(v)
    if t == "table" then return tabelaTexto(v, nivel, mostrar, 6) end
    if t == "string" then return string.format("%q", v) end
    if t == "number" then return numero(v) end
    if t == "Instance" then return v:GetFullName() end
    local ok, s = pcall(tostring, v)
    return ok and s or ("<" .. t .. ">")
end

