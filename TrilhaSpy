    if c.metodo == "OnClientInvoke" then
        avisar("Can't replay OnClientInvoke")
    elseif c.metodo == "OnClientEvent" then
        if firesignal then
            task.spawn(firesignal, c.remote.OnClientEvent, table.unpack(args, 1, args.n))
            avisar(c.truncado and "Event replayed (args were truncated)" or "Event replayed")
        else
            avisar("firesignal unavailable")
        end
    else
        task.spawn(function()
            local ok, err = pcall(function()
                local remote = c.remote
                remote[c.metodo](remote, table.unpack(args, 1, args.n))
            end)
            if not ok then
                warn("[Remote Log] repetir: " .. tostring(err))
            end
        end)
        avisar(c.truncado and "Call replayed (args were truncated)" or "Call replayed")
    end
end

