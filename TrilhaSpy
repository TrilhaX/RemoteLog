local function textoInfoFuncao(c)
    local linhas = { "--- Function Info", "", "local Info = {" }
    local function add(chave, valor)
        table.insert(linhas, "    " .. chave .. " = " .. mostrar(valor, 1) .. ",")
    end

    add("Origin", c.origem)
    if c.script then
        local ok, nome = pcall(function()
            return c.script:GetFullName()
        end)
        if ok then
            add("Script", nome)
        end
    end
    if not c.func then
        add("Function", "not captured")
        table.insert(linhas, "}")
        return table.concat(linhas, "\n")
    end

    add("Function", c.nomeFuncao ~= "" and c.nomeFuncao or "(anonymous)")
    add("Source", c.fonte)
    add("Line", c.linha)
    local ok, params, vararg = pcall(debug.info, c.func, "a")
    if ok then
        add("Parameters", params)
        add("Vararg", vararg)
    end

    local lerUpvalues = getupvalues or (debug and debug.getupvalues)
    if lerUpvalues then
        local okU, upvalues = pcall(lerUpvalues, c.func)
        if okU then
            add("Upvalues", upvalues)
        end
    end
    local lerConstantes = getconstants or (debug and debug.getconstants)
    if lerConstantes then
        local okC, constantes = pcall(lerConstantes, c.func)
        if okC then
            add("Constants", constantes)
        end
    end

    local pilha = {}
    for i, frame in ipairs(c.pilha or {}) do
        pilha[i] = ("%s:%s %s"):format(frame[1], tostring(frame[2]), frame[3] ~= "" and frame[3] or "(anonymous)")
    end
    add("Stack", pilha)
    table.insert(linhas, "}")
    return table.concat(linhas, "\n")
end

