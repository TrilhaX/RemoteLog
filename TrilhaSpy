local function serializar(v, nivel)
    nivel = nivel or 0
    local t = typeof(v)

    if t == "string" then return string.format("%q", v) end
    if t == "number" then return numero(v) end
    if t == "boolean" or t == "nil" or t == "EnumItem" then return tostring(v) end
    if t == "table" then return tabelaTexto(v, nivel, serializar, 8) end
    if t == "Instance" then
        if v == game then return "game" end
        if v:IsDescendantOf(game) then return caminho(v) end
        return ("nil --[[ no parent: %s ]]"):format(v.Name)
    end
    if t == "Vector3" then return ("Vector3.new(%s, %s, %s)"):format(v.X, v.Y, v.Z) end
    if t == "Vector2" then return ("Vector2.new(%s, %s)"):format(v.X, v.Y) end
    if t == "CFrame" then return ("CFrame.new(%s)"):format(table.concat({ v:GetComponents() }, ", ")) end
    if t == "Color3" then return ("Color3.new(%s, %s, %s)"):format(v.R, v.G, v.B) end
    if t == "BrickColor" then return ("BrickColor.new(%q)"):format(v.Name) end
    if t == "UDim" then return ("UDim.new(%s, %s)"):format(v.Scale, v.Offset) end
    if t == "UDim2" then
        return ("UDim2.new(%s, %s, %s, %s)"):format(v.X.Scale, v.X.Offset, v.Y.Scale, v.Y.Offset)
    end
    return ("nil --[[ %s: %s ]]"):format(t, tostring(v))
end

local function inline(v, nivel)
    nivel = nivel or 0
    if typeof(v) ~= "table" then
        return (mostrar(v):gsub("\n", " "))
    end
    if next(v) == nil then
        return "{}"
    end
    if nivel >= 3 then
        return "{...}"
    end
    local partes, indice, qtd = {}, 1, 0
    for k, val in next, v do
        qtd += 1
        if qtd > 12 then
            table.insert(partes, "...")
            break
        end
        if k == indice then
            indice += 1
            table.insert(partes, inline(val, nivel + 1))
        else
            table.insert(partes, chaveTabela(k, mostrar, nivel) .. " = " .. inline(val, nivel + 1))
        end
    end
    return "{" .. table.concat(partes, ", ") .. "}"
end

local CABECALHO = "--- Generated by Remote Log\n\n"

local function declararRemote(remote)
    if remote:IsDescendantOf(game) then
        return "local Remote = " .. caminho(remote) .. "\n"
    end
    return ("local Remote\nfor _, i in getnilinstances() do\n    if i.Name == %q and i.ClassName == %q then\n        Remote = i\n    end\nend\n"):format(remote.Name, remote.ClassName)
end

local function argsEmLinhas(c)
    if c.args.n == 0 then
        return ""
    end
    local linhas = {}
    for i = 1, c.args.n do
        linhas[i] = "    " .. serializar(c.args[i], 1)
    end
    return "\n" .. table.concat(linhas, ",\n") .. "\n"
end

local function codigoChamada(grupo, c)
    local base = CABECALHO .. declararRemote(grupo.remote)
    local args = argsEmLinhas(c)
    if c.metodo == "OnClientEvent" then
        local sep = args ~= "" and "," or ""
        return base .. "firesignal(Remote.OnClientEvent" .. sep .. args .. ")"
    end
    if c.metodo == "OnClientInvoke" then
        return base .. 'getcallbackvalue(Remote, "OnClientInvoke")(' .. args .. ")"
    end
    return base .. "Remote:" .. c.metodo .. "(" .. args .. ")"
end

local function codigoInterceptar(grupo, c)
    local base = CABECALHO .. declararRemote(grupo.remote) .. "\n"
    if c.metodo == "OnClientInvoke" then
        return base .. [[local old = getcallbackvalue(Remote, "OnClientInvoke")
Remote.OnClientInvoke = function(...)
    print("Invoked", ...)
    if old then
        return old(...)
    end
end]]
    end
    if grupo.aba == "entrada" then
        return base .. [[Remote.OnClientEvent:Connect(function(...)
    print("Received", ...)
end)]]
    end
    return base .. ([[local old
old = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
    if self == Remote and getnamecallmethod() == %q then
        local args = table.pack(...)
        -- modify args here
        return old(self, table.unpack(args, 1, args.n))
    end
    return old(self, ...)
end))]]):format(c.metodo)
end

