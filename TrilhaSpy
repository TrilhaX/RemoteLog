    Text = "",
    ZIndex = 9,
}, main)

do
    local MIN_L, MIN_A = 440, 280
    local linhas = {}
    local ativoInput, inicio, baseTam, basePos, baseEsq

    for i = 1, 3 do
        linhas[i] = criar("Frame", {
            AnchorPoint = Vector2.new(1, 1),
            Position = UDim2.new(1, -3, 1, -3 - (i - 1) * 4),
            Size = UDim2.fromOffset(2 + (i - 1) * 4, 2),
            BackgroundColor3 = COR.apagado,
            BorderSizePixel = 0,
        }, alca)
        canto(linhas[i], 1)
    end

    local function pintar(cor)
        for _, l in ipairs(linhas) do
            l.BackgroundColor3 = cor
        end
    end

    alca.MouseEnter:Connect(function()
        pintar(COR.violeta)
    end)
    alca.MouseLeave:Connect(function()
        if not ativoInput then
            pintar(COR.apagado)
        end
    end)

    alca.InputBegan:Connect(function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1
            and input.UserInputType ~= Enum.UserInputType.Touch then
            return
        end
        -- Fixa o tamanho atual antes de soltar o limite, senão a janela pula.
        baseTam, basePos = main.AbsoluteSize, main.Position
        baseEsq = main.AbsolutePosition - gui.AbsolutePosition
        TAMANHO = UDim2.fromOffset(baseTam.X, baseTam.Y)
        main.Size = TAMANHO
        limiteMain.MaxSize = Vector2.new(math.huge, math.huge)
        ativoInput, inicio = input, input.Position
        pintar(COR.violeta)
    end)

    table.insert(conexoes, UIS.InputChanged:Connect(function(input)
        if not ativoInput or (input ~= ativoInput
            and input.UserInputType ~= Enum.UserInputType.MouseMovement) then
            return
        end
        -- Máximo = espaço entre o canto superior esquerdo (fixo) e a borda da tela.
        local livre = gui.AbsoluteSize - baseEsq
        local l = math.floor(math.clamp(baseTam.X + input.Position.X - inicio.X, MIN_L, math.max(MIN_L, livre.X)))
        local a = math.floor(math.clamp(baseTam.Y + input.Position.Y - inicio.Y, MIN_A, math.max(MIN_A, livre.Y)))
        TAMANHO = UDim2.fromOffset(l, a)
        main.Size = TAMANHO
        -- O canto superior esquerdo fica parado: a âncora é o centro.
        main.Position = UDim2.new(
            basePos.X.Scale, basePos.X.Offset + (l - baseTam.X) / 2,
            basePos.Y.Scale, basePos.Y.Offset + (a - baseTam.Y) / 2
        )
    end))

    table.insert(conexoes, UIS.InputEnded:Connect(function(input)
        if ativoInput and (input == ativoInput
            or input.UserInputType == Enum.UserInputType.MouseButton1) then
            ativoInput = nil
            pintar(COR.apagado)
        end
    end))
end

