do
    local PASTA = "One Hub/RemoteLog"
    local function carregar(nome, png)
        local arquivo = PASTA .. "/" .. nome .. ".png"
        writefile(arquivo, png)
        return getcustomasset(arquivo)
    end

    local ok, raio, cubo = pcall(function()
        for _, pasta in ipairs({ "One Hub", PASTA }) do
            if not isfolder(pasta) then
                makefolder(pasta)
            end
        end
        return carregar("RemoteEvent", PNG_RAIO), carregar("RemoteFunction", PNG_CUBO)
    end)
    if ok then
        ICONE_IMAGEM.RemoteEvent = raio
        ICONE_IMAGEM.UnreliableRemoteEvent = raio
        ICONE_IMAGEM.RemoteFunction = cubo
    else
        warn("[Remote Log] icons: " .. tostring(raio))
    end

    local okCursor, cursor = pcall(carregar, "Cursor", PNG_CURSOR)
    ICONE_IMAGEM.Cursor = okCursor and cursor or "rbxasset://textures/Cursors/KeyboardMouse/ArrowFarCursor.png"
end

-- Helpers de UI
local function criar(classe, props, pai)
    local obj = Instance.new(classe)
    for k, v in pairs(props) do
        obj[k] = v
    end
    obj.Parent = pai
    return obj
end

local function canto(obj, raio)
    criar("UICorner", { CornerRadius = UDim.new(0, raio or 6) }, obj)
end

local function rotulo(props, pai)
    local base = {
        BackgroundTransparency = 1,
        TextColor3 = COR.texto,
        TextXAlignment = Enum.TextXAlignment.Left,
        Font = Enum.Font.Gotham,
        TextSize = 12,
    }
    for k, v in pairs(props) do
        base[k] = v
    end
    return criar("TextLabel", base, pai)
end

local function botao(props, pai)
    local base = {
        BackgroundColor3 = COR.item,
        BorderSizePixel = 0,
        AutoButtonColor = true,
        TextColor3 = COR.texto,
        Font = Enum.Font.GothamMedium,
        TextSize = 12,
    }
    for k, v in pairs(props) do
        base[k] = v
    end
    local b = criar("TextButton", base, pai)
    canto(b, 5)
    return b
