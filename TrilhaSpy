-- Ícone desenhado com Frames: seta única = evento, setas opostas = chamada com retorno.
local function desenharSeta(pai, cor, y, x1, x2)
    local sentido = x2 > x1 and 1 or -1
    local function barra(x, yBarra, largura, rotacao)
        criar("Frame", {
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.fromOffset(x, yBarra),
            Size = UDim2.fromOffset(largura, 2),
            Rotation = rotacao,
            BackgroundColor3 = cor,
            BorderSizePixel = 0,
        }, pai)
    end
    barra((x1 + x2) / 2, y, math.abs(x2 - x1), 0)
    barra(x2 - sentido * 2, y - 2, 6, sentido * 45)
    barra(x2 - sentido * 2, y + 2, 6, -sentido * 45)
end

