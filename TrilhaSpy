local CORES_CODIGO = {
    palavra = "#BE9FFF",
    texto = "#96E18C",
    numero = "#F5C86E",
    valor = "#F587AF",
    comentario = "#7D7391",
}
local PALAVRAS = {}
for p in ("local function end if then else elseif for in do while repeat until return not and or break"):gmatch("%a+") do
    PALAVRAS[p] = true
end
local VALORES = { ["true"] = true, ["false"] = true, ["nil"] = true }
local ESCAPES = { ["&"] = "&amp;", ["<"] = "&lt;", [">"] = "&gt;" }

local function escapar(t)
    return (t:gsub("[&<>]", ESCAPES))
end

local function realcar(codigo)
    local saida, pos, n = {}, 1, #codigo
    local function pintar(tipo, t)
        table.insert(saida, ('<font color="%s">%s</font>'):format(CORES_CODIGO[tipo], escapar(t)))
    end

    while pos <= n do
        local resto2 = codigo:sub(pos, pos + 1)
        local c = codigo:sub(pos, pos)
        local token
        if resto2 == "--" then
            token = codigo:match("^%-%-%[%[.-%]%]", pos) or codigo:match("^%-%-[^\n]*", pos)
            pintar("comentario", token)
        elseif c == '"' then
            local i = pos + 1
            while i <= n do
                local b = codigo:byte(i)
                if b == 92 then
                    i += 2
                elseif b == 34 then
                    break
                else
                    i += 1
                end
            end
            token = codigo:sub(pos, math.min(i, n))
            pintar("texto", token)
        elseif c:match("%d") then
            token = codigo:match("^[%d%.]+", pos)
            pintar("numero", token)
        elseif c:match("[%a_]") then
            token = codigo:match("^[%w_]+", pos)
            if PALAVRAS[token] then
                pintar("palavra", token)
            elseif VALORES[token] then
                pintar("valor", token)
            else
                table.insert(saida, token)
            end
        else
            token = c
            table.insert(saida, escapar(c))
        end
        pos += #token
    end
    return table.concat(saida)
end

