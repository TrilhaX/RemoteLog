    for _, filho in ipairs(listaExcl:GetChildren()) do
        if filho:IsA("Frame") then
            filho:Destroy()
        end
    end

    local itens = {}
    for remote, nome in pairs(excluidos) do
        table.insert(itens, { remote = remote, nome = nome, lista = excluidos, tag = "Ignored" })
    end
    for remote, nome in pairs(bloqueados) do
        table.insert(itens, { remote = remote, nome = nome, lista = bloqueados, tag = "Blocked" })
