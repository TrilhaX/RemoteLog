        TextXAlignment = Enum.TextXAlignment.Right,
        TextSize = 11,
    }, cabeca)

    local btnCopiar = botao({
        AnchorPoint = Vector2.new(1, 0),
        Position = UDim2.new(1, 0, 0, 1),
        Size = UDim2.fromOffset(56, 20),
        BackgroundColor3 = COR.linha,
        Text = "Copy",
        TextSize = 11,
    }, cabeca)
    btnCopiar.MouseButton1Click:Connect(function()
        copiar(btnCopiar, codigoChamada(grupo, c))
    end)

    if c.args.n == 0 then
        rotulo({
            Size = UDim2.new(1, 0, 0, 16),
            Text = "No arguments",
            TextColor3 = COR.apagado,
            LayoutOrder = 1,
        }, cartao)
    end
    for i = 1, visiveis do
        local ok, err = pcall(linhaArg, cartao, i, c.args[i], 26)
        if not ok then
            warn("[Remote Log] arg " .. i .. ": " .. tostring(err))
        end
    end
    if c.args.n > visiveis then
        rotulo({
            Size = UDim2.new(1, 0, 0, 16),
            Text = "+" .. (c.args.n - visiveis) .. " arguments",
            TextColor3 = COR.apagado,
            LayoutOrder = visiveis + 1,
        }, cartao)
    end

    table.insert(cartoes, cartao)
    if #cartoes > MAX_CHAMADAS then
        table.remove(cartoes, 1):Destroy()
    end
end

